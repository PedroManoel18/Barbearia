# ==============================================================================
# CONFIGURAÇÃO DO SUPABASE - BARBEARIA GARAGE
# Copie este arquivo para ".env" e preencha com as credenciais do seu projeto Supabase:
# ==============================================================================

# URL do seu projeto Supabase (encontrado em Project Settings > API):
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (encontrada em Project Settings > API > Project API keys > anon public):
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
